rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approvedStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == 'teacher'
        && myProfile().authorized == true
        && myProfile().status == 'approved';
    }

    function approvedStaffForSchool(schoolId) {
      return approvedStaff() && myProfile().school == schoolId;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ['parent', 'teacher']
        && (
          (request.resource.data.role == 'parent'
            && request.resource.data.authorized == true
            && request.resource.data.status == 'approved')
          ||
          (request.resource.data.role == 'teacher'
            && request.resource.data.authorized == false
            && request.resource.data.status == 'pending_approval')
        );

      // Users can read their own profile. Approved staff can review profiles.
      allow read: if signedIn() && (request.auth.uid == userId || approvedStaff());

      // A client cannot promote itself or change its authorization state.
      // Administrative approval should be performed by a trusted admin process.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.authorized == resource.data.authorized
        && request.resource.data.status == resource.data.status;

      allow delete: if false;
    }

    match /schools/{schoolId} {
      // Distribution points and stock availability are public app information.
      allow read: if true;
      // Only approved staff assigned to this facility can manage its inventory.
      allow create, update: if approvedStaffForSchool(schoolId)
        && request.resource.data.name == schoolId;
      allow delete: if false;
    }

    match /requests/{requestId} {
      // Requests can contain personal information: only the owner and approved staff may read.
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || approvedStaff());

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Owners can edit their own request details but cannot alter ownership or review status.
      allow update: if signedIn() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'ownerUid', 'reviewedByUid'])
        )
        ||
        (
          approvedStaff()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'reviewedByUid'])
        )
      );
      allow delete: if false;
    }

    match /restock_requests/{requestId} {
      // Facility requisitions are restricted to their facility and approved staff.
      allow read: if signedIn() && (
        resource.data.createdByUid == request.auth.uid
        || approvedStaffForSchool(resource.data.school)
      );
      allow create: if signedIn()
        && approvedStaffForSchool(request.resource.data.school)
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn()
        && approvedStaffForSchool(resource.data.school)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.school == resource.data.school;
      allow delete: if false;
    }

    match /donations/{donationId} {
      // Only non-identifying pledge fields may be stored in this public collection.
      // Client-created pledges always remain pending until a trusted payment verifier
      // marks them completed using the Admin SDK / a server-side integration.
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'amountUgx', 'provider', 'sponsoredKits', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == donationId
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.amountUgx is int
        && request.resource.data.amountUgx > 0
        && request.resource.data.sponsoredKits is int
        && request.resource.data.sponsoredKits >= 0
        && request.resource.data.provider in [
          'MTN Mobile Money', 'Airtel Money', 'Card'
        ];
      allow update, delete: if false;
    }
  }
}
